---
import { format } from "date-fns";
import Base from "@/layouts/Base.astro";
import { postPath } from "@/lib/article-meta";
import { getPosts } from "@/lib/posts";
import { AUTHOR_NAME, AUTHOR_URL, SITE_NAME, SITE_TAGLINE } from "@/lib/site";

const posts = await getPosts();
---

<Base title={SITE_NAME} description={SITE_TAGLINE}>
	<main class="mx-auto max-w-3xl pt-16 pb-24 sm:pt-20">
		<header>
			<h1 class="font-serif text-5xl sm:text-6xl font-bold leading-tight tracking-tight text-blog-title">
				{SITE_NAME}
			</h1>
			<p class="mt-4 pb-0 text-xl leading-relaxed text-blog-summary">
				{SITE_TAGLINE},{" "}
				<span class="whitespace-nowrap">
					by{" "}
					<a
						href={AUTHOR_URL}
						class="text-blog-title underline decoration-stone-300 decoration-1 underline-offset-4 hover:text-blog-title hover:decoration-current dark:text-blog-title dark:decoration-stone-600 dark:hover:text-blog-title"
					>
						{AUTHOR_NAME}
					</a>
				</span>
			</p>
		</header>
		<hr class="mt-10 mb-6 border-current opacity-20" />
		<div class="space-y-1">
			{
				posts.map((post) => (
					<a
						href={postPath(post)}
						class="group block rounded-lg px-4 py-4 -mx-4 hover:bg-white hover:shadow-xs dark:hover:bg-stone-900 transition-all duration-200 no-underline"
					>
						<div class="flex flex-col-reverse sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6">
							<h2 class="text-lg font-semibold leading-snug text-blog-title group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-200 p-0 tracking-normal">
								{post.data.title}
							</h2>
							<time
								datetime={format(new Date(post.data.publishDate), "yyyy-MM-dd")}
								class="text-sm text-stone-400 tabular-nums shrink-0 dark:text-stone-500"
							>
								{format(new Date(post.data.publishDate), "MMM d, yyyy")}
							</time>
						</div>
						{post.data.summary && (
							<p class="mt-1.5 text-[0.9375rem] leading-relaxed text-blog-summary line-clamp-2 pb-0">
								{post.data.summary}
							</p>
						)}
					</a>
				))
			}
		</div>
	</main>
</Base>
