---
import { format } from "date-fns";
import Base from "@/layouts/Base.astro";
import { generatePath } from "@/lib/article-meta";
import { getPosts } from "@/lib/posts";

const posts = await getPosts();
---

<Base title="Sal's Blog" description="Thoughts from a programmer">
	<main class="mx-auto max-w-3xl py-16">
		<h1 class="font-serif text-4xl font-medium tracking-tight text-stone-900 mb-12 dark:text-stone-100">
			All Posts
		</h1>
		<div class="space-y-1">
			{
				posts.map((post) => (
					<a
						href={`/posts${generatePath(post)}`}
						class="group block rounded-lg px-4 py-4 -mx-4 hover:bg-white hover:shadow-xs dark:hover:bg-stone-900 transition-all duration-200 no-underline"
					>
						<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
							<h2 class="text-base font-medium text-stone-900 group-hover:text-indigo-600 dark:text-stone-100 dark:group-hover:text-indigo-400 transition-colors duration-200 p-0 tracking-normal">
								{post.data.title}
							</h2>
							<time
								datetime={format(new Date(post.data.publishDate), "yyyy-MM-dd")}
								class="text-sm text-stone-400 tabular-nums shrink-0 dark:text-stone-500"
							>
								{format(new Date(post.data.publishDate), "MMM d, yyyy")}
							</time>
						</div>
						{post.data.summary && (
							<p class="mt-1 text-sm leading-5 text-stone-500 line-clamp-1 pb-0 dark:text-stone-400">
								{post.data.summary}
							</p>
						)}
					</a>
				))
			}
		</div>
	</main>
</Base>
