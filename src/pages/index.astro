---
import { format } from "date-fns";
import Base from "@/layouts/Base.astro";
import { generatePath } from "@/lib/article-meta";
import { getPosts } from "@/lib/posts";
import { AUTHOR_NAME, AUTHOR_URL, SITE_NAME, SITE_TAGLINE } from "@/lib/site";

const posts = await getPosts();
---

<Base title={SITE_NAME} description={SITE_TAGLINE}>
	<main class="mx-auto max-w-2xl py-16">
		<header class="mb-12">
			<h1 class="font-serif text-4xl font-medium tracking-tight text-stone-900 mb-3">
				{SITE_NAME}
			</h1>
			<p class="text-lg text-stone-500 leading-relaxed pb-0">
				{SITE_TAGLINE}, by <a href={AUTHOR_URL}>{AUTHOR_NAME}</a>
			</p>
		</header>
		<div class="space-y-1">
			{
				posts.map((post) => (
					<a
						href={`/posts${generatePath(post)}`}
						class="group block rounded-lg px-4 py-4 -mx-4 hover:bg-white hover:shadow-xs transition-all duration-200 no-underline"
					>
						<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
							<h2 class="text-base font-medium text-stone-900 group-hover:text-indigo-600 transition-colors duration-200 p-0 tracking-normal">
								{post.data.title}
							</h2>
							<time class="text-sm text-stone-400 tabular-nums shrink-0">
								{format(new Date(post.data.publishDate), "MMM d, yyyy")}
							</time>
						</div>
						{post.data.summary && (
							<p class="mt-1 text-sm leading-5 text-stone-500 line-clamp-1 pb-0">
								{post.data.summary}
							</p>
						)}
					</a>
				))
			}
		</div>
	</main>
</Base>
