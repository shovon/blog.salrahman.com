---
import { render } from "astro:content";
import { format } from "date-fns";
import Base from "@/layouts/Base.astro";
import { getMeta } from "@/lib/article-meta";
import { ogImagePath } from "@/lib/og";
import { getPosts, type Post } from "@/lib/posts";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: getMeta(post),
		props: { post },
	}));
}

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base
	title={post.data.title}
	description={post.data.summary}
	type="article"
	publishDate={post.data.publishDate}
	image={ogImagePath(post)}
>
	<main class="mx-auto max-w-3xl py-12">
		<article>
			<header>
				<time
					datetime={format(post.data.publishDate, "yyyy-MM-dd")}
					class="text-sm font-medium text-blog-date uppercase tracking-wider"
				>
					{format(post.data.publishDate, "MMMM d, yyyy")}
				</time>
				<h1 class="mt-4 font-serif text-4xl md:text-5xl font-bold leading-tight text-blog-title">
					{post.data.title}
				</h1>
				{
					post.data.summary && (
						<p class="mt-6 pb-0 text-xl font-light leading-relaxed text-blog-summary">
							{post.data.summary}
						</p>
					)
				}
			</header>
			<hr class="my-6 border-current opacity-20" />
			<div>
				<section class="prose-article">
					<Content />
				</section>
			</div>
		</article>
	</main>
</Base>
