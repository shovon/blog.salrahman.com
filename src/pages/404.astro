---
import Base from "@/layouts/Base.astro";
---

<Base
	title="Page not found"
	description="The page you were looking for doesn't exist."
	noindex
>
	<main class="mx-auto max-w-2xl py-16">
		<p class="text-sm font-medium text-indigo-600 uppercase tracking-wider pb-0">
			404
		</p>
		<h1 class="font-serif text-4xl sm:text-5xl font-medium tracking-tight text-stone-900 mt-3 mb-4 leading-tight sm:leading-none">
			Page not found
		</h1>
		<p class="text-lg text-stone-500 leading-relaxed">
			The page you were looking for doesn't exist. It may have moved, or the
			link may be mistyped.
		</p>
		<a href="/">&larr; Back to all posts</a>
	</main>
</Base>
