---
import { render } from "astro:content";
import { format } from "date-fns";
import Base from "@/layouts/Base.astro";
import { getMeta } from "@/lib/article-meta";
import { ogImagePath } from "@/lib/og";
import { getPosts, type Post } from "@/lib/posts";
import { sourceUrl } from "@/lib/source";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: getMeta(post),
		props: { post },
	}));
}

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const source = sourceUrl(post.filePath);
---

<Base
	title={post.data.title}
	description={post.data.summary}
	type="article"
	publishDate={post.data.publishDate}
	image={ogImagePath(post)}
>
	<main class="mx-auto max-w-2xl py-16">
		<article>
			<header class="mb-10">
				<time class="text-sm font-medium text-indigo-600 uppercase tracking-wider">
					{format(post.data.publishDate, "MMMM d, yyyy")}
				</time>
				<h1 class="font-serif text-4xl sm:text-5xl font-medium tracking-tight text-stone-900 mt-3 mb-4 leading-tight sm:leading-none">
					{post.data.title}
				</h1>
				{
					post.data.summary && (
						<p class="text-lg text-stone-500 leading-relaxed pb-0">
							{post.data.summary}
						</p>
					)
				}
			</header>
			<div class="border-t border-stone-200 pt-10">
				<section class="prose-article">
					<Content />
				</section>
			</div>
			{
				source && (
					<footer class="mt-16 border-t border-stone-200 pt-6">
						<a
							href={source}
							class="text-sm text-stone-500 hover:text-stone-800 transition-colors"
						>
							View the source of this post on GitHub
						</a>
					</footer>
				)
			}
		</article>
	</main>
</Base>
